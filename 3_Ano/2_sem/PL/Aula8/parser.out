DIV                  : 12
EQ                   : 3
EXCLAMATION          : 4
HASH                 : 7
IDEN                 : 3 5 16
INT                  : 14
MUL                  : 11
QUESTION             : 5
STAR                 : 6
SUB                  : 9
error                : 

