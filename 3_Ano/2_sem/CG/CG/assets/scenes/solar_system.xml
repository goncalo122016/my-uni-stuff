<?xml version="1.0" encoding="UTF-8" ?>
<world>
    <window width="1024" height="768" />

    <camera>
        <position x="60" y="35" z="60" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="0.5" far="3000" />
    </camera>

    <!-- Enhanced Lighting System -->
    <lights>
        <!-- Point light: the Sun, warm yellow, STRONG (increased for visibility) -->
        <light type="point"
               posX="0" posY="0" posZ="0"
               diffuseR="1.0"  diffuseG="0.95" diffuseB="0.75"
               specularR="1.0" specularG="0.95" specularB="0.80"
               ambientR="0.15" ambientG="0.12" ambientB="0.08" />

        <!-- Directional: enhanced cold fill to see dark sides better -->
        <light type="directional"
               dirX="1" dirY="0.3" dirZ="0.5"
               diffuseR="0.15" diffuseG="0.15" diffuseB="0.20"
               specularR="0.05" specularG="0.05" specularB="0.08"
               ambientR="0.05"  ambientG="0.05"  ambientB="0.08" />

        <!-- Spotlight: blue-white beam near Saturn, aimed at the planet (enhanced) -->
        <light type="spot"
               posX="48" posY="15" posZ="15"
               dirX="0" dirY="-1" dirZ="-0.5"
               cutoff="20"
               diffuseR="0.6"  diffuseG="0.7"  diffuseB="1.0"
               specularR="0.6" specularG="0.7" specularB="1.0"
               ambientR="0.05" ambientG="0.05" ambientB="0.1" />

        <!-- Point light: rim light from opposite side (enhanced) -->
        <light type="point"
               posX="-200" posY="50" posZ="-200"
               diffuseR="0.12" diffuseG="0.14" diffuseB="0.20"
               specularR="0.05" specularG="0.05" specularB="0.08"
               ambientR="0.05"  ambientG="0.05"  ambientB="0.08" />
    </lights>

