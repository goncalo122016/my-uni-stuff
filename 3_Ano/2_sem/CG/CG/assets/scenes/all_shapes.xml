<world>
    <window width="1024" height="768" />
    <camera>
        <position x="10" y="8" z="10" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="1000" />
    </camera>

    <group>
        <!-- Rotating Sphere -->
        <group>
            <transform>
                <translate x="-6" y="0" z="0" />
                <rotate time="5" x="0" y="1" z="0" />
            </transform>
            <models>
                <model file="assets/models/sphere.3d" />
            </models>
        </group>

        <!-- Tumbling Box -->
        <group>
            <transform>
                <translate x="-3" y="0" z="0" />
                <rotate time="4" x="1" y="1" z="1" />
            </transform>
            <models>
                <model file="assets/models/box.3d" />
            </models>
        </group>

        <!-- Spinning Cone -->
        <group>
            <transform>
                <translate x="0" y="0" z="0" />
                <rotate time="3" x="1" y="0" z="0" />
            </transform>
            <models>
                <model file="assets/models/cone.3d" />
            </models>
        </group>

        <!-- Cylinder traveling along a Catmull-Rom Curve -->
        <group>
            <transform>
                <translate time="6" align="true">
                    <point x="3" y="0" z="3" />
                    <point x="6" y="2" z="0" />
                    <point x="3" y="0" z="-3" />
                    <point x="0" y="2" z="0" />
                </translate>
            </transform>
            <models>
                <model file="assets/models/cylinder.3d" />
            </models>
        </group>

        <!-- Spinning Plane -->
        <group>
            <transform>
                <translate x="6" y="0" z="0" />
                <rotate time="2" x="0" y="0" z="1" />
            </transform>
            <models>
                <model file="assets/models/plane.3d" />
            </models>
        </group>

        <!-- Rolling Torus -->
        <group>
            <transform>
                <translate x="-4" y="3" z="0" />
                <rotate time="6" x="1" y="0" z="0" />
            </transform>
            <models>
                <model file="assets/models/torus.3d" />
            </models>
        </group>

        <!-- Floating & Spinning Icosphere -->
        <group>
            <transform>
                <translate x="0" y="3" z="0" />
                <rotate time="7" x="0" y="1" z="1" />
            </transform>
            <models>
                <model file="assets/models/icosphere.3d" />
            </models>
        </group>

        <!-- Angled & Rotating Torus -->
        <group>
            <transform>
                <translate x="4" y="3" z="0" />
                <rotate time="4" x="0" y="1" z="0" />
                <rotate angle="45" x="1" y="1" z="0" />
                <scale x="0.8" y="0.8" z="0.8" />
            </transform>
            <models>
                <model file="assets/models/torus.3d" />
            </models>
        </group>

        <!-- Orbiting Composite Object -->
        <group>
            <transform>
                <translate x="0" y="-3" z="0" />
                <rotate time="10" x="0" y="1" z="0" />
            </transform>

            <!-- Center Cylinder -->
            <group>
                <models>
                    <model file="assets/models/cylinder.3d" />
                </models>
            </group>

            <!-- Orbiting Icosphere 1 -->
            <group>
                <transform>
                    <translate x="2" y="0" z="0" />
                    <rotate time="2" x="0" y="1" z="0" />
                    <scale x="0.3" y="0.3" z="0.3" />
                </transform>
                <models>
                    <model file="assets/models/icosphere.3d" />
                </models>
            </group>

            <!-- Orbiting Icosphere 2 -->
            <group>
                <transform>
                    <translate x="-2" y="0" z="0" />
                    <rotate time="2" x="0" y="1" z="0" />
                    <scale x="0.3" y="0.3" z="0.3" />
                </transform>
                <models>
                    <model file="assets/models/icosphere.3d" />
                </models>
            </group>

            <!-- Orbiting Icosphere 3 -->
            <group>
                <transform>
                    <translate x="0" y="0" z="2" />
                    <rotate time="2" x="1" y="0" z="0" />
                    <scale x="0.3" y="0.3" z="0.3" />
                </transform>
                <models>
                    <model file="assets/models/icosphere.3d" />
                </models>
            </group>

            <!-- Orbiting Icosphere 4 -->
            <group>
                <transform>
                    <translate x="0" y="0" z="-2" />
                    <rotate time="2" x="1" y="0" z="0" />
                    <scale x="0.3" y="0.3" z="0.3" />
                </transform>
                <models>
                    <model file="assets/models/icosphere.3d" />
                </models>
            </group>
        </group>

        <!-- Static Floor Plane -->
        <group>
            <transform>
                <translate x="0" y="-2" z="0" />
                <scale x="10" y="1" z="10" />
            </transform>
            <models>
                <model file="assets/models/plane.3d" />
            </models>
        </group>
    </group>
</world>
